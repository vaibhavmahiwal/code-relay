# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If using local MongoDB: mongodb://localhost:27017/rakshak
# If using MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/rakshak
MONGO_URI=mongodb://localhost:27017/rakshak_final

# AI Integration (Groq SDK)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_actual_key_goes_here

# Frontend URL (For CORS settings)
FRONTEND_URL=http://localhost:5173